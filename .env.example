# Copy this file to .env.local and fill in your own keys.
# .env.local is git-ignored — never commit real keys.

# Required — Google Gemini (AI chat + disease detection)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — Gemini model id (default gemini-2.5-flash)
# GEMINI_MODEL=

# Weather (Open-Meteo), market prices (WFP/HDX), World Bank, NASA POWER and GDACS need no keys.

# Recommended in production — Upstash Redis for rate limiting /api/chat and /api/detect
# across all Vercel instances (free tier is enough). Without these, limits are per-instance only.
# Create a database at https://console.upstash.com (or add the Upstash integration on Vercel,
# which sets KV_REST_API_URL / KV_REST_API_TOKEN — those names work too).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional — override the World Bank API base URL
# WORLD_BANK_API_URL=https://api.worldbank.org/v2
